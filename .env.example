# Copy to .env for local development: cp .env.example .env
# Validated at boot by src/config/env.schema.ts; the app refuses to start if invalid.

# development | test | production. Swagger (/api/docs) is disabled in production.
NODE_ENV=development

# HTTP port.
PORT=4000

# Dev Postgres from docker-compose.yml (service "postgres", host port 5433).
# Tests use the "postgres-test" service on 5434 (override with TEST_DATABASE_URL).
DATABASE_URL="postgresql://kritex:kritex@localhost:5433/kritex?schema=public"
# Hosted (Render): the Neon connection string, e.g.
# postgresql://<user>:<password>@ep-xxx.ap-southeast-1.aws.neon.tech/kritex?sslmode=require

# Comma-separated browser origins allowed by CORS (credentials are allowed).
# 8080 = Vite dev server of kritex-website.
CORS_ORIGIN="http://localhost:8080,http://localhost:8081"

# TEMPORARY admin auth for GET /api/v1/queries (Authorization: Bearer <key>).
# Replaced by Better Auth sessions + roles in Stage 2. Use a long random value outside dev.
ADMIN_API_KEY="change-me"

# Optional. Number of reverse proxies in front of the app (Express "trust proxy") so req.ip and
# rate limits see the real client IP. Leave unset locally; 1 on Render.
# TRUST_PROXY=1

# Optional pino log level: fatal | error | warn | info | debug | trace | silent.
# Default: info (silent when NODE_ENV=test).
# LOG_LEVEL=debug

# ---- Seed (`npx prisma db seed`; read by prisma/seed only, not by the app) ----
# DEV ONLY: placeholder prices / HSN / GST / weights and 25 units of stock per new variant.
# Leave unset (or false) for real environments; real data comes from `npm run import:products`.
# SEED_PLACEHOLDER_PRICES=true
# Creates (or promotes) this user to ADMIN with a verified email. No password is stored here:
# sign-in is set up through Better Auth (Stage 2).
# SEED_ADMIN_EMAIL=admin@kritex.in
# SEED_ADMIN_NAME="Kritex Admin"
