# Copy to .env for local development: cp .env.example .env
# Validated at boot by src/config/env.schema.ts; the app refuses to start if invalid.

# ---- Production (Render) checklist. Values below this block are for local dev. ----
# Required (the API refuses to boot without the starred ones):
#   NODE_ENV=production *
#   DATABASE_URL=<Neon, direct (non -pooler) host, ?sslmode=require> *
#   BETTER_AUTH_SECRET=<openssl rand -base64 32> *
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET *
#   TRUST_PROXY=1                                   (Render's proxy; rate limits need the client IP)
#   BETTER_AUTH_URL=https://api.kritex.in           (public API origin; RL-1: browser calls it directly)
#   WEB_URL=https://kritex.in
#   CORS_ORIGIN=https://kritex.in,https://www.kritex.in
#   AUTH_COOKIE_DOMAIN=.kritex.in                   (session cookie shared by kritex.in + api.kritex.in)
# Needed for a working store:
#   RESEND_API_KEY + MAIL_FROM                      (else sign-up/order emails are only logged; MAIL_FROM's
#                                                    domain must be verified in Resend, e.g. Kritex <no-reply@kritex.in>)
#   GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET         (Continue with Google; see the Google block below)
#   STORAGE_DRIVER=r2 + R2_*                        (Render's disk is wiped on redeploy: uploads, invoice PDFs)
#   SELLER_LEGAL_NAME / SELLER_GSTIN / SELLER_ADDRESS / BUSINESS_STATE_CODE   (printed on GST invoices)
# Optional: BANK_TRANSFER_* (all four), SHIPROCKET_* (else manual shipping), SELLER_EMAIL/PHONE.
# PORT is set by Render. Remove the prototype's ADMIN_API_KEY.

# development | test | production. Swagger (/api/docs) is disabled in production.
NODE_ENV=development

# HTTP port.
PORT=4000

# Dev Postgres from docker-compose.yml (service "postgres", host port 5433).
# Tests use the "postgres-test" service on 5434 (override with TEST_DATABASE_URL).
DATABASE_URL="postgresql://kritex:kritex@localhost:5433/kritex?schema=public"
# Hosted (Render): the Neon connection string, e.g.
# postgresql://<user>:<password>@ep-xxx.ap-southeast-1.aws.neon.tech/kritex?sslmode=require

# Comma-separated browser origins allowed by CORS (credentials are allowed).
# 8080 = Vite dev server of kritex-website.
CORS_ORIGIN="http://localhost:8080,http://localhost:8081"

# ---- Auth (Better Auth, mounted at /api/v1/auth) ----
# >= 32 random chars: `openssl rand -base64 32`. Required in production; dev/test fall back to a
# fixed, public value when unset.
# BETTER_AUTH_SECRET=
# Public origin of this API (no path). Used in links inside auth emails; https => secure cookies.
BETTER_AUTH_URL=http://localhost:4000
# Storefront origin: trusted redirect target (verify / reset links) and staff invite links.
WEB_URL=http://localhost:8080
# Production only: share the session cookie between kritex.in and api.kritex.in.
# AUTH_COOKIE_DOMAIN=.kritex.in
# ---- Continue with Google (ADR-019). Optional: set both or neither. ----
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID (type: Web application).
# Add every environment to the same client:
#   Authorised JavaScript origins:  https://www.kritex.in            http://localhost:8080
#   Authorised redirect URIs:       https://api.kritex.in/api/v1/auth/callback/google
#                                   http://localhost:4000/api/v1/auth/callback/google
# (redirect URI = <BETTER_AUTH_URL>/api/v1/auth/callback/google). Unset = the button is hidden
# (GET /api/v1/auth-options -> { "google": false }).
# GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# ---- Mail (SMTP fallback when RESEND_API_KEY is unset; see Notifications below) ----
# Unset SMTP_HOST: emails (with links / codes) are printed to the server log in development.
# Mailpit: `docker run -p 1025:1025 -p 8025:8025 axllent/mailpit`, then SMTP_HOST=localhost.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM="Kritex <no-reply@kritex.in>"

# Optional. Number of reverse proxies in front of the app (Express "trust proxy") so req.ip and
# rate limits see the real client IP. Leave unset locally; 1 on Render.
# TRUST_PROXY=1

# Optional pino log level: fatal | error | warn | info | debug | trace | silent.
# Default: info (silent when NODE_ENV=test).
# LOG_LEVEL=debug

# ---- Uploads (admin product images / spec sheets, CAT-6) ----
# local (default): files go to UPLOADS_DIR and are served at /api/v1/uploads/local/... (dev only).
# r2: presigned PUT URLs to Cloudflare R2; set every R2_* var below.
# STORAGE_DRIVER=local
# UPLOADS_DIR=uploads
# Origin prefixed to local upload URLs; empty = relative URLs (works through the Vite /api proxy).
# UPLOADS_BASE_URL=http://localhost:4000
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=kritex-media
# R2_PUBLIC_URL=https://cdn.kritex.in

# ---- Pricing (src/pricing; ADR-005/006). Money in paise; rates in percent. All optional. ----
# PLACEHOLDERS until Kritex's CA confirms (Q9). Seller's GST state code (27 = Maharashtra).
# BUSINESS_STATE_CODE=27
# Rate for non-slab products that have no gstRate of their own.
# GST_DEFAULT_RATE=18
# Apparel/made-ups/footwear: per-unit taxable value <= threshold -> low rate, else high rate.
# GST_SLAB_HSN_PREFIXES=61,62,63,64
# GST_SLAB_THRESHOLD_PAISE=250000
# GST_SLAB_LOW_RATE=5
# GST_SLAB_HIGH_RATE=18
# Flat shipping (GST-inclusive), free when merchandise total after discount >= threshold.
# SHIPPING_FLAT_FEE_PAISE=9900
# SHIPPING_FREE_THRESHOLD_PAISE=99900

# ---- Cart (COM-1). Optional. ----
# Guest cart cookie (`kritex_cart`) lifetime in days; abandoned guest carts are purged after this.
# CART_GUEST_TTL_DAYS=30

# ---- Payments (Razorpay, ADR-003) ----
# Unset RAZORPAY_KEY_ID = the fake gateway (dev/test only): POST /checkout returns
# razorpay.keyId "rzp_fake"; POST /checkout/verify accepts razorpay_payment_id "pay_fake_<anything>"
# with razorpay_signature "fake" ("pay_fake_fail..." = a failed payment). Required in production.
# Test keys: Razorpay dashboard (Test mode) -> Account & Settings -> API keys.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Webhook secret you set on Dashboard -> Webhooks (events: payment.captured, payment.failed,
# refund.processed, refund.failed) pointing at <api>/api/v1/webhooks/razorpay.
# RAZORPAY_WEBHOOK_SECRET=
# Unpaid orders are cancelled and their stock released after this many minutes (default 30).
# ORDER_PAYMENT_TIMEOUT_MINUTES=30
# Bank transfer (approved B2B accounts only). Offered only when all four are set.
# BANK_TRANSFER_ACCOUNT_NAME="Kritex Pvt Ltd"
# BANK_TRANSFER_ACCOUNT_NUMBER=
# BANK_TRANSFER_IFSC=
# BANK_TRANSFER_BANK_NAME=
# Unpaid bank-transfer orders keep their stock reserved this many days, then are cancelled (0 = never).
# BANK_TRANSFER_HOLD_DAYS=7

# ---- Notifications (OPS-1) ----
# Set = all emails (order, quote and auth) go through Resend (https://resend.com, verify the
# MAIL_FROM domain there first). Unset = SMTP_HOST above, else logged (dev).
# RESEND_API_KEY=re_xxxxxxxx

# ---- GST invoices (OPS-2, ADR-006). PLACEHOLDERS until Kritex's CA confirms (Q9). ----
# Numbers are <INVOICE_PREFIX>/<FY>/<00001>, sequential per Indian financial year (Apr-Mar, IST).
# PDFs are stored with STORAGE_DRIVER (local: <UPLOADS_DIR>/.private/invoices, never served
# publicly; r2: same bucket, key invoices/<random>.pdf, handed out as short-lived presigned GETs).
# INVOICE_PREFIX=KTX
# SELLER_LEGAL_NAME="Kritex Pvt Ltd"
# SELLER_GSTIN=27ABCDE1234F1Z5
# Address lines separated by "|".
# SELLER_ADDRESS="Unit 1, Some Estate|Mumbai, Maharashtra 400001"
# SELLER_EMAIL=orders@kritex.in
# SELLER_PHONE=+91 98765 43210

# ---- Shipping (Shiprocket, ADR-005 / OPS-3) ----
# Unset SHIPROCKET_EMAIL = the fake provider (dev/test only; refused in production): AWBs are
# FAKE<digits>, carrier "Fake Courier", labels/tracking point at example URLs.
# Use a dedicated Shiprocket API user (Settings -> API -> Create an API user).
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external
# Pickup address nickname as configured on Shiprocket.
# SHIPROCKET_PICKUP_LOCATION=Primary
# Token Shiprocket sends in the x-api-key header of tracking webhooks (Settings -> API -> Webhooks,
# URL <api>/api/v1/webhooks/shiprocket). Required in production; dev/test default fake-shiprocket-token.
# SHIPROCKET_WEBHOOK_TOKEN=

# ---- Seed (`npx prisma db seed`; read by prisma/seed only, not by the app) ----
# DEV ONLY: placeholder prices / HSN / GST / weights and 25 units of stock per new variant.
# Leave unset (or false) for real environments; real data comes from `npm run import:products`.
# SEED_PLACEHOLDER_PRICES=true
# Creates (or promotes) this user to ADMIN with a verified email.
# SEED_ADMIN_EMAIL=admin@kritex.in
# SEED_ADMIN_NAME="Kritex Admin"
# Optional (>= 8 chars): gives that admin an email+password login, only if it has no password yet.
# Without it, sign in with an email OTP or "forgot password" (dev: the email is in the server log).
# SEED_ADMIN_PASSWORD=
