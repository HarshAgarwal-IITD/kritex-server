# Copy to .env for local development: cp .env.example .env
# Validated at boot by src/config/env.schema.ts; the app refuses to start if invalid.

# development | test | production. Swagger (/api/docs) is disabled in production.
NODE_ENV=development

# HTTP port.
PORT=4000

# Dev Postgres from docker-compose.yml (service "postgres", host port 5433).
# Tests use the "postgres-test" service on 5434 (override with TEST_DATABASE_URL).
DATABASE_URL="postgresql://kritex:kritex@localhost:5433/kritex?schema=public"

# Comma-separated browser origins allowed by CORS (credentials are allowed).
# 8080 = Vite dev server of kritex-website.
CORS_ORIGIN="http://localhost:8080,http://localhost:8081"

# ---- Auth (Better Auth, mounted at /api/v1/auth) ----
# >= 32 random chars: `openssl rand -base64 32`. Required in production; dev/test fall back to a
# fixed, public value when unset.
# BETTER_AUTH_SECRET=
# Public origin of this API (no path). Used in links inside auth emails; https => secure cookies.
BETTER_AUTH_URL=http://localhost:4000
# Storefront origin: trusted redirect target (verify / reset links) and staff invite links.
WEB_URL=http://localhost:8080
# Production only: share the session cookie between kritex.in and api.kritex.in.
# AUTH_COOKIE_DOMAIN=.kritex.in

# ---- Mail (auth emails; OPS-1 replaces this with the real provider) ----
# Unset SMTP_HOST: emails (with links / codes) are printed to the server log in development.
# Mailpit: `docker run -p 1025:1025 -p 8025:8025 axllent/mailpit`, then SMTP_HOST=localhost.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# MAIL_FROM="Kritex <no-reply@kritex.in>"

# Optional pino log level: fatal | error | warn | info | debug | trace | silent.
# Default: info (silent when NODE_ENV=test).
# LOG_LEVEL=debug

# ---- Seed (`npx prisma db seed`; read by prisma/seed only, not by the app) ----
# DEV ONLY: placeholder prices / HSN / GST / weights and 25 units of stock per new variant.
# Leave unset (or false) for real environments; real data comes from `npm run import:products`.
# SEED_PLACEHOLDER_PRICES=true
# Creates (or promotes) this user to ADMIN with a verified email.
# SEED_ADMIN_EMAIL=admin@kritex.in
# SEED_ADMIN_NAME="Kritex Admin"
# Optional (>= 8 chars): gives that admin an email+password login, only if it has no password yet.
# Without it, sign in with an email OTP or "forgot password" (dev: the email is in the server log).
# SEED_ADMIN_PASSWORD=
